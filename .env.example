CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_PREVIEW_ACCESS_TOKEN=
CONTENTFUL_PREVIEW_SECRET=
# Any long random string. Contentful's publish webhook sends it to /api/purge.
CONTENTFUL_WEBHOOK_SECRET=
# The public origin, used for canonical links. Defaults to https://beuseful.net.
SITE_URL=
# Set to true on the production build only. Anything else keeps every response
# noindex and robots.txt closed.
ALLOW_INDEXING=
# Optional. A Cloudflare Web Analytics site token, only used on a build with
# ALLOW_INDEXING=true. Leave empty for no analytics.
ANALYTICS_TOKEN=
# Set to true to render pages on request and hold them in Cloudflare's cache,
# so a publish shows within seconds. Anything else builds every page static.
ROUTE_CACHE=
