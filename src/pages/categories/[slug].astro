---
import PostStream from "../../components/PostStream.astro";
import Layout from "../../layouts/Layout.astro";
import {
  getAllAuthors,
  getAllCategories,
  getAllPosts,
  getCategoryBySlug,
  getGermanPostSlugs,
} from "../../lib/api";
import { listingPageTags } from "../../lib/cache-tags";
import { SITE_TITLE, SITE_URL } from "../../lib/constants";
import { hold, missing } from "../../lib/route-cache";
import { visibleTagSlugs } from "../../lib/tags";

// A strand page is home with its header chip pressed: every post in the
// strand, no pager, trail or description. The chip names it.
export async function getStaticPaths() {
  const categories = await getAllCategories(false);
  return categories.map((category) => ({ params: { slug: category.slug } }));
}

const slug = Astro.params.slug!;
// The authors are the footer's, read here for the cache tags.
const [category, allPosts, germanSlugs, authors] = await Promise.all([
  getCategoryBySlug(slug, false),
  getAllPosts(false),
  getGermanPostSlugs(false),
  getAllAuthors(false),
]);
if (!category) return missing(Astro, `No published category for "${slug}".`);

const posts = allPosts.filter((post) => post.category?.slug === slug);
hold(Astro.cache, listingPageTags(posts, authors, category));
const closing =
  posts.length === 0
    ? "Nothing here yet."
    : posts.length === 1
      ? `That’s the only ${category.name} post.`
      : `That’s all ${posts.length} ${category.name} posts.`;
---

<Layout
  title={`${category.name} | ${SITE_TITLE}`}
  description={
    category.description || `Posts in ${category.name} on ${SITE_TITLE}`
  }
  canonical={`${SITE_URL}/categories/${slug}`}
  social={{
    title: `${category.name} | ${SITE_TITLE}`,
    shortTitle: category.name,
  }}
>
  <div class="mx-auto max-w-frame px-4 md:px-10 pt-6 pb-16">
    <h1 class="sr-only">{category.name}</h1>
    <PostStream
      posts={posts}
      visibleTags={visibleTagSlugs(allPosts)}
      showStrand={false}
      germanSlugs={new Set(germanSlugs)}
    />

    <p class="mt-12 text-center font-ui font-semibold text-brand-muted">
      {`${closing} `}
      <a
        href="/archive"
        class="text-brand-crimson underline decoration-2 underline-offset-[3px] hover:decoration-4"
      >
        The archive
      </a>{" "}
      has everything else.
    </p>
  </div>
</Layout>
