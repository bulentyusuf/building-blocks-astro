---
import Tape from "../components/Tape.astro";
import Layout from "../layouts/Layout.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../lib/constants";

// Home's archive button, so a way out reads as pressable.
const action =
  "inline-flex min-h-11 items-center rounded-xl border-[3px] border-outline bg-card px-5 font-ui text-base font-semibold shadow-[4px_4px_0_var(--color-brand-crimson)] transition-[translate,box-shadow] duration-150 hover:translate-[4px] hover:shadow-none motion-reduce:transition-none";
---

<Layout
  title={`Page not found | ${SITE_TITLE}`}
  description={SITE_DESCRIPTION}
  noindex
>
  <div class="max-w-frame mx-auto px-4 md:px-10 pt-8 pb-12">
    <section class="mx-auto max-w-2xl text-center">
      <!-- A picture pinned to an empty page: ink frame, tape, a -2deg tilt.
           The one named exception to the tilt and tape rules. -->
      <div class="relative mx-auto mt-4 w-full max-w-md -rotate-2">
        <Tape class="z-10" />
        <img
          src="/404-gremlin.webp"
          alt="A gremlin sitting in a tangle of wires, holding the two ends of an unplugged cable"
          width="720"
          height="480"
          fetchpriority="high"
          class="h-auto w-full rounded-container border-[3px] border-outline"
        />
      </div>

      <p class="mt-9 font-mono text-sm font-medium text-brand-muted">
        <span aria-hidden="true">// </span>error 404
      </p>
      <h1 class="mt-3 text-5xl leading-none font-[800] tracking-[-0.03em] text-balance md:text-6xl">
        A gremlin pulled the plug.
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-pretty md:text-[1.375rem]">
        Someone fed it after midnight. The page you wanted is gone.
      </p>
      <nav
        aria-label="Recovery options"
        class="mt-8 flex flex-wrap items-center justify-center gap-4"
      >
        <a href="/search" class={action}>
          Search
        </a>
        <a href="/archive" class={action}>
          Archive
        </a>
      </nav>
    </section>
  </div>
</Layout>
