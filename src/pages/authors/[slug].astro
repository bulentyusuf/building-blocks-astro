---
import CollectionPage from "../../components/CollectionPage.astro";
import ContentfulImage from "../../components/ContentfulImage.astro";
import Layout from "../../layouts/Layout.astro";
import {
  getAllAuthors,
  getAllPosts,
  getAuthorBySlug,
  getGermanPostSlugs,
} from "../../lib/api";
import { postsByAuthor } from "../../lib/authors";
import { listingPageTags } from "../../lib/cache-tags";
import { SITE_TITLE, SITE_URL } from "../../lib/constants";
import { squareJpeg } from "../../lib/image";
import { renderRichText } from "../../lib/rich-text";
import { hold, missing } from "../../lib/route-cache";
import { visibleTagSlugs } from "../../lib/tags";
import { widont } from "../../lib/typography";

export async function getStaticPaths() {
  const authors = await getAllAuthors(false);
  return authors
    .filter((author) => author.slug)
    .map((author) => ({ params: { slug: author.slug } }));
}

// A link preview's portrait, in px: past the small card's 144px minimum.
const PORTRAIT_CARD = 600;

const slug = Astro.params.slug!;
// Filtered in memory: Contentful cannot filter on a list of links.
// Every author too: the footer's, read here for the cache tags.
const [author, allPosts, germanSlugs, authors] = await Promise.all([
  getAuthorBySlug(slug, false),
  getAllPosts(false),
  getGermanPostSlugs(false),
  getAllAuthors(false),
]);
if (!author) return missing(Astro, `No published author for "${slug}".`);

const posts = postsByAuthor(allPosts, slug);
hold(Astro.cache, listingPageTags(posts, authors, author));
const closing =
  posts.length === 0
    ? "No posts by this author yet."
    : posts.length === 1
      ? `That’s the only post by ${author.name}.`
      : `That’s all ${posts.length} posts by ${author.name}.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: author.name,
    url: `${SITE_URL}/authors/${slug}`,
    image: author.picture?.url,
  },
};
---

<Layout
  title={`${author.name} | ${SITE_TITLE}`}
  description={`Posts by ${author.name} on ${SITE_TITLE}`}
  canonical={`${SITE_URL}/authors/${slug}`}
  social={{
    title: `${author.name} | ${SITE_TITLE}`,
    shortTitle: author.name,
    image: author.picture?.url
      ? {
          url: squareJpeg(author.picture.url, PORTRAIT_CARD),
          alt: `Portrait of ${author.name}`,
          width: PORTRAIT_CARD,
          height: PORTRAIT_CARD,
        }
      : undefined,
  }}
>
  <CollectionPage
    posts={posts}
    visibleTags={visibleTagSlugs(allPosts)}
    germanSlugs={new Set(germanSlugs)}
    closing={closing}
    jsonLd={jsonLd}
  >
    <div class="flex items-center gap-5 md:gap-7">
      {author.picture?.url && (
        <ContentfulImage
          src={author.picture.url}
          alt=""
          width={112}
          height={112}
          class="h-20 w-20 shrink-0 rounded-full border-[3px] border-outline object-cover md:h-28 md:w-28"
        />
      )}
      <h1 class="text-[length:min(3rem,13.5vw)] leading-[0.98] font-[800] tracking-[-0.03em] text-pretty wrap-break-word md:text-6xl lg:text-7xl">
        {widont(author.name)}
      </h1>
    </div>
    {author.bio && (
      <div
        data-bio
        class="mt-6 max-w-2xl text-lg leading-relaxed text-pretty text-brand-muted [&_a]:font-medium [&_a]:text-brand-crimson [&_a]:underline [&_p+p]:mt-3"
        set:html={renderRichText({ content: author.bio, headings: [] })}
      />
    )}
  </CollectionPage>
</Layout>
