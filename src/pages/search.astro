---
import Tape from "../components/Tape.astro";
import TagPill from "../components/TagPill.astro";
import WidePage from "../components/WidePage.astro";
import Layout from "../layouts/Layout.astro";
import { getAllPosts } from "../lib/api";
import { SITE_TITLE } from "../lib/constants";
import { groupPostsByTag } from "../lib/tags";

// Search runs on Pagefind's web components with a house result template. The
// markup is ours; keyboard and ARIA behaviour is upstream's. The index and
// every query stay in the browser.

// Every tag with a page, through the same threshold as the tag pages.
const tags = groupPostsByTag(await getAllPosts(false)).map((g) => g.tag);

// The main link must be an <a> for the components' keyboard handling. meta.url
// wins over the file path; the strand pill and date read the post's indexed
// meta. A string, because the braces are the template's, not Astro's.
const RESULT_TEMPLATE = `
<script type="text/pagefind-template">
  <li class="result-item px-5 py-6 sm:px-7">
    <p class="mb-2.5 flex flex-wrap items-center gap-2.5">
      {{#if meta.strand}}
      <span class="{{ meta.strandfill }} rounded-full border-2 border-brand-dark px-2 py-0.5 font-ui text-xs font-bold uppercase tracking-[0.06em] text-on-strand">{{ meta.strand }}</span>
      {{/if}}
      {{#if meta.date}}
      <span class="font-ui text-[0.9375rem] font-semibold tabular-nums text-brand-muted">{{ meta.date }}</span>
      {{/if}}
    </p>
    <p class="font-ui text-2xl leading-tight font-[800] md:text-[1.625rem]">
      <a class="result-link text-brand-dark pointer-coarse:relative pointer-coarse:py-2 transition-colors duration-200 hover:text-brand-crimson" href="{{ meta.url | default(url) | safeUrl }}">{{ meta.title | default("Untitled") }}</a>
    </p>
    {{#if excerpt}}
    <p class="mt-2 text-lg leading-relaxed text-brand-dark">{{+ excerpt +}}</p>
    {{/if}}
    {{#if sub_results}}
    <ul class="mt-3 space-y-3 pl-4">
      {{#each sub_results as sub}}
      <li>
        <p class="font-display text-lg font-bold leading-tight">
          <span aria-hidden="true" class="mr-2 font-normal text-brand-muted">↳</span><a class="text-brand-dark pointer-coarse:relative pointer-coarse:py-3 transition-colors duration-200 hover:text-brand-crimson" href="{{ sub.url | safeUrl }}">{{ sub.title }}</a>
        </p>
        <p class="mt-1 leading-relaxed text-brand-dark">{{+ sub.excerpt +}}</p>
      </li>
      {{/each}}
    </ul>
    {{/if}}
  </li>
</script>
`;
---

<Layout
  title={`Search | ${SITE_TITLE}`}
  description="Search every post on the site."
  noindex
>
  <WidePage heading="Search">
    <!-- Results up to 720px, the tag panel beside them from lg, where both
         fit; it stays while searching. -->
    <div class="lg:grid lg:grid-cols-[minmax(0,45rem)_minmax(17.5rem,22.5rem)] lg:items-start lg:justify-between lg:gap-16">
      <section>
        <!-- Without scripts the input never appears, so say why. Underlined:
             crimson against the muted text is far below 3:1. -->
        <noscript>
          <p class="mb-6 text-brand-muted">
            Search needs JavaScript. The index runs entirely in your browser, so
            no query ever leaves this page — which also means there is nothing
            to search with when scripts are turned off. The{" "}
            <a
              href="/archive"
              class="font-bold text-brand-crimson underline underline-offset-2 transition-opacity duration-200 hover:opacity-80"
            >
              archive
            </a>{" "}
            lists every post by year.
          </p>
        </noscript>
        <p data-search-failed hidden class="text-brand-muted">
          Search is unavailable. The index is generated at build time, so it
          does not exist until a build has run.
        </p>
        <div class="pagefind-scope">
          <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
          <pagefind-config excerpt-length="30"></pagefind-config>
          <pagefind-input placeholder="What are you looking for?"></pagefind-input>
          <!-- Hidden by the styles below while the input is empty. -->
          <pagefind-summary></pagefind-summary>
          <pagefind-results set:html={RESULT_TEMPLATE} />
        </div>
        <!-- Hides on the first keystroke: the rule needs it to be the next
             sibling of .pagefind-scope. Smaller on phones, so the tag panel
             shows above the fold. -->
        <div class="search-empty">
          <figure class="mx-auto mt-6 max-w-[9rem] p-4 sm:mt-10 sm:max-w-[16rem] sm:p-8">
            <img
              src="/search-emblem.svg"
              alt=""
              width="1735"
              height="1867"
              class="h-auto w-full"
            />
          </figure>
        </div>
      </section>
      <!-- Sticky from lg, scrolling on its own if taller than the window. The
           top padding keeps the tape inside the scroll box, and the matching
           negative margin lines the panel up with the input. -->
      <aside class="mt-12 lg:sticky lg:top-20 lg:-mt-5 lg:max-h-[calc(100dvh-6rem)] lg:overflow-y-auto lg:pt-5">
        <!-- A taped note, the page's one strip of tape. -->
        <div class="relative rounded-container border-[3px] border-outline bg-card px-5.5 pt-6 pb-6">
          <Tape />
          {tags.length > 0 && (
            <>
              <p
                id="tag-entry-label"
                class="font-ui text-xl leading-tight font-[800]"
              >
                Or start from a tag
              </p>
              <ul
                aria-labelledby="tag-entry-label"
                class="mt-4 mb-5 flex flex-wrap gap-2 pointer-coarse:gap-y-3"
              >
                {tags.map((tag) => (
                  <li>
                    <TagPill tag={tag} size="compact" />
                  </li>
                ))}
              </ul>
            </>
          )}
          <p class="leading-relaxed text-brand-muted">
            Or browse every post in the{" "}
            <a
              href="/archive"
              class="text-brand-crimson underline decoration-2 underline-offset-[3px] hover:decoration-4"
            >
              archive
            </a>
            .
          </p>
        </div>
      </aside>
    </div>
  </WidePage>
</Layout>

<script>
  import {
    cameBack,
    rememberSearches,
    restoreSearch,
    tabStorage,
    type PagefindInstance,
  } from "../lib/search-memory";

  // Pagefind's script is loaded here and nowhere else on the site. It is
  // written by the build beside the pages, so it is addressed by URL.
  const loader = document.createElement("script");
  loader.type = "module";
  loader.src = "/pagefind/pagefind-component-ui.js";
  loader.onerror = () => {
    document.querySelector(".pagefind-scope")?.setAttribute("hidden", "");
    document.querySelector("[data-search-failed]")?.removeAttribute("hidden");
  };
  loader.onload = () => {
    const components = (
      window as {
        PagefindComponents?: {
          getInstanceManager: () => {
            getInstance: (name: string) => PagefindInstance;
          };
        };
      }
    ).PagefindComponents;
    const instance = components?.getInstanceManager().getInstance("default");
    if (!instance) return;
    // The term is remembered in this tab only, never in the address.
    const storage = tabStorage(window);
    rememberSearches(instance, storage);
    const [entry] = performance.getEntriesByType(
      "navigation",
    ) as PerformanceNavigationTiming[];
    if (cameBack(entry, location.href)) restoreSearch(instance, storage);
  };
  document.body.append(loader);
</script>

<style is:global>
  /* Pagefind's components, themed through their documented --pf-* properties.
     Style the component hosts or the template's own classes, never a pf-*
     class: the component resets those. No !important anywhere. */
  .pagefind-scope {
    /* The body face: excerpt and summary are body copy. */
    --pf-font: var(--font-body), Georgia, serif;
    --pf-text: var(--color-brand-dark);
    --pf-text-secondary: var(--color-brand-muted);
    --pf-text-muted: var(--color-brand-muted);
    --pf-background: transparent;
    /* The input's own 1px edge is hidden; its host draws the 3px ink box. */
    --pf-border: transparent;
    --pf-border-focus: var(--color-brand-crimson);
    --pf-border-radius: 0.6875rem;
    --pf-input-height: 3.625rem;
    --pf-input-font-size: 1.375rem;
    --pf-summary-font-size: 0.875rem;
    --pf-outline-focus: var(--color-brand-crimson);
  }

  .pagefind-scope mark {
    background: color-mix(in srgb, var(--color-brand-crimson) 18%, transparent);
    color: inherit;
    border-radius: 2px;
    padding: 0 2px;
  }

  /* The 18% wash is tuned on cream and all but vanishes on charcoal. */
  @media (prefers-color-scheme: dark) {
    .pagefind-scope mark {
      background: color-mix(
        in srgb,
        var(--color-brand-crimson) 50%,
        transparent
      );
    }
  }

  .pagefind-scope pagefind-input {
    /* The typed query is UI text. */
    --pf-font: var(--font-ui), sans-serif;
    display: block;
    border: 3px solid var(--color-outline);
    border-radius: 14px;
    background-color: var(--color-card);
    /* Holds the box's height before its script loads. */
    min-height: calc(var(--pf-input-height) + 6px);
  }
  .pagefind-scope pagefind-results:has(.result-item) {
    display: block;
    overflow: hidden;
    border: 2px solid var(--color-edge-quiet);
    border-radius: 1.5rem;
    background-color: var(--color-card);
  }
  .pagefind-scope .result-item:nth-child(even) {
    background-color: var(--color-brand-bg);
  }

  /* The summary as a // label, the slashes kept out of its accessible name. */
  .pagefind-scope pagefind-summary {
    display: none;
    gap: 1ch;
    font-family: var(--font-mono);
    font-weight: 500;
    margin-top: 2rem;
    padding-bottom: 0.75rem;
  }
  .pagefind-scope pagefind-summary::before {
    content: "//" / "";
    font-size: var(--pf-summary-font-size);
    color: var(--color-brand-muted);
  }
  /* Shown once a query is typed, so it never flashes before the input loads.
     Toggled from the preceding input: a descendant :has does not invalidate
     reliably here. */
  .pagefind-scope
    pagefind-input:has(input:not(:placeholder-shown))
    ~ pagefind-summary {
    display: flex;
  }

  /* The emblem shows only while the input is empty, so the placeholder must
     stay non-empty. */
  .pagefind-scope:has(input:not(:placeholder-shown)) + .search-empty {
    display: none;
  }
</style>
