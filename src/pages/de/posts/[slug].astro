---
import PostPage from "../../../components/PostPage.astro";
import {
  getAllAuthors,
  getAllPosts,
  getGermanPostAndMorePosts,
  getGermanPostSlugs,
} from "../../../lib/api";
import { postPageTags } from "../../../lib/cache-tags";
import { hold, missing } from "../../../lib/route-cache";

// Only translated posts have a German page. German has no fallback.
export async function getStaticPaths() {
  const slugs = await getGermanPostSlugs(false);
  return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug!;
// The authors are the footer's, read here for the cache tags.
const [{ post, morePosts }, allPosts, authors] = await Promise.all([
  getGermanPostAndMorePosts(slug, false),
  getAllPosts(false),
  getAllAuthors(false),
]);
if (!post) return missing(Astro, `No published German post for "${slug}".`);
hold(Astro.cache, postPageTags(post, morePosts, authors));
---

<PostPage
  post={post}
  morePosts={morePosts}
  allPosts={allPosts}
  slug={slug}
  german
  translated
/>
