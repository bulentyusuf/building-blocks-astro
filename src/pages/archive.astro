---
import PostRow from "../components/PostRow.astro";
import WidePage from "../components/WidePage.astro";
import Layout from "../layouts/Layout.astro";
import { getAllAuthors, getAllPosts, getGermanPostSlugs } from "../lib/api";
import { indexPageTags } from "../lib/cache-tags";
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from "../lib/constants";
import { hold } from "../lib/route-cache";
import type { ListPost } from "../lib/types";

// The authors are the footer's, read here for the cache tags.
const [posts, germanSlugs, authors] = await Promise.all([
  getAllPosts(false),
  getGermanPostSlugs(false),
  getAllAuthors(false),
]);
hold(Astro.cache, indexPageTags(authors));
const german = new Set(germanSlugs);

// Posts arrive newest first, so each year's list does too.
const byYear = new Map<number, ListPost[]>();
for (const post of posts) {
  const year = new Date(post.date).getUTCFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
const title = `Archive | ${SITE_TITLE}`;
---

<Layout
  title={title}
  description={SITE_DESCRIPTION}
  canonical={`${SITE_URL}/archive`}
  social={{ title }}
>
  <WidePage heading="Archive">
    {years.length === 0 ? (
      <p class="text-lg text-brand-muted">No posts yet.</p>
    ) : (
      // One panel, each year a heading inside it.
      <div class="overflow-hidden rounded-container border-2 border-edge-quiet bg-card">
        {years.map((year) => {
          const yearPosts = byYear.get(year)!;
          return (
            <section class="border-t-2 border-edge-quiet first:border-t-0">
              {/* The year is the page's spine; the count a muted label. */}
              <h2 class="flex items-baseline gap-4 px-5 pt-6 pb-3 sm:px-7">
                <span class="text-4xl leading-none font-[800] tracking-[-0.02em] tabular-nums md:text-5xl lg:text-[3.25rem]">
                  {year}
                </span>
                <span class="font-mono text-sm font-medium text-brand-muted">
                  <span aria-hidden="true">// </span>
                  {`${yearPosts.length} ${yearPosts.length === 1 ? "post" : "posts"}`}
                </span>
              </h2>
              <ul>
                {yearPosts.map((post) => (
                  <PostRow
                    post={post}
                    german={german.has(post.slug)}
                    date="dayMonth"
                    showStrand
                  />
                ))}
              </ul>
            </section>
          );
        })}
      </div>
    )}
  </WidePage>
</Layout>
