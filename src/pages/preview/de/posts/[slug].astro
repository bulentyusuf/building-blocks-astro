---
import { getGermanPostAndMorePosts } from "../../../../lib/api";

export const prerender = false;

const { slug } = Astro.params;
const { post } = await getGermanPostAndMorePosts(slug!, true);
if (!post) return new Response("Unknown slug", { status: 404 });
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{post.title}</title>
  </head>
  <body>
    <form method="post" action="/api/exit-preview">
      <button type="submit">Exit preview</button>
    </form>
    <h1 lang="de-DE">{post.title}</h1>
    <p lang="de-DE">{post.excerpt}</p>
  </body>
</html>
