---
import PostPage from "../../../../components/PostPage.astro";
import { getAllPosts, getGermanPostAndMorePosts } from "../../../../lib/api";

// The German draft of a post, rendered on request. The middleware has already
// checked the preview session.
export const prerender = false;

const slug = Astro.params.slug!;
const [{ post, morePosts }, allPosts] = await Promise.all([
  getGermanPostAndMorePosts(slug, true),
  getAllPosts(true),
]);
if (!post) return new Response("Unknown slug", { status: 404 });
---

<PostPage
  post={post}
  morePosts={morePosts}
  allPosts={allPosts}
  slug={slug}
  german
  translated
  preview
/>
