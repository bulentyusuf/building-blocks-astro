---
import PostPage from "../../../components/PostPage.astro";
import {
  getAllPosts,
  getGermanPostSlugs,
  getPostAndMorePosts,
} from "../../../lib/api";

// The draft of a post, rendered on request. The middleware has already
// checked the preview session.
export const prerender = false;

const slug = Astro.params.slug!;
const [{ post, morePosts }, allPosts, germanSlugs] = await Promise.all([
  getPostAndMorePosts(slug, true),
  getAllPosts(true),
  getGermanPostSlugs(true),
]);
if (!post) return new Response("Unknown slug", { status: 404 });
---

<PostPage
  post={post}
  morePosts={morePosts}
  allPosts={allPosts}
  slug={slug}
  german={false}
  translated={germanSlugs.includes(slug)}
  preview
/>
