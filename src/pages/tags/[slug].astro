---
import CollectionPage from "../../components/CollectionPage.astro";
import Layout from "../../layouts/Layout.astro";
import {
  getAllAuthors,
  getAllPosts,
  getGermanPostSlugs,
  getTagBySlug,
} from "../../lib/api";
import { listingPageTags } from "../../lib/cache-tags";
import { SITE_TITLE, SITE_URL } from "../../lib/constants";
import { hold, missing } from "../../lib/route-cache";
import { postsWithTag, visibleTagSlugs } from "../../lib/tags";
import { widont } from "../../lib/typography";

// Only tags the index shows: a tag gets a page with its second post.
export async function getStaticPaths() {
  const posts = await getAllPosts(false);
  return [...visibleTagSlugs(posts)].map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug!;
// The authors are the footer's, read here for the cache tags.
const [tag, allPosts, germanSlugs, authors] = await Promise.all([
  getTagBySlug(slug, false),
  getAllPosts(false),
  getGermanPostSlugs(false),
  getAllAuthors(false),
]);
const visible = visibleTagSlugs(allPosts);
// On request the same floor applies: a one-post tag has no page.
if (!tag || !visible.has(slug)) {
  return missing(Astro, `No published tag with a page for "${slug}".`);
}

const posts = postsWithTag(allPosts, slug);
hold(Astro.cache, listingPageTags(posts, authors, tag));
// Each card's own tag pill would repeat the page; the others still show.
const otherTags = new Set([...visible].filter((s) => s !== slug));
---

<Layout
  title={`${tag.name} | ${SITE_TITLE}`}
  description={tag.description || `Posts tagged ${tag.name} on ${SITE_TITLE}`}
  canonical={`${SITE_URL}/tags/${slug}`}
  social={{ title: `${tag.name} | ${SITE_TITLE}`, shortTitle: tag.name }}
>
  <CollectionPage
    crumbs={[
      { label: "Home", href: "/" },
      { label: "Tags", href: "/tags" },
      { label: tag.name },
    ]}
    posts={posts}
    visibleTags={otherTags}
    germanSlugs={new Set(germanSlugs)}
    closing={`That’s all ${posts.length} posts tagged ${tag.name}.`}
  >
    <h1 class="text-[length:min(3rem,13.5vw)] leading-[0.98] font-[800] tracking-[-0.03em] text-pretty wrap-break-word md:text-6xl lg:text-7xl">
      <span aria-hidden="true">#</span>
      {widont(tag.name)}
    </h1>
  </CollectionPage>
</Layout>
