---
import PostStream from "./PostStream.astro";
import { jsonLdHtml } from "../lib/json-ld";
import type { ListPost } from "../lib/types";

// A tag or author page: a strand page with a visible h1, since no chip names
// it. Every post, as cards then rows, no pager, no description.
// The default slot is the heading.
interface Props {
  posts: ListPost[];
  /** Tag slugs with a live page. */
  visibleTags: Set<string>;
  germanSlugs: Set<string>;
  /** The closing line's lead-in, before "The archive has everything else." */
  closing: string;
  jsonLd?: unknown;
}
const { posts, visibleTags, germanSlugs, closing, jsonLd } = Astro.props;
---

<div class="mx-auto max-w-frame px-4 md:px-10 pt-8 pb-16">
  {jsonLd !== undefined && (
    <script type="application/ld+json" set:html={jsonLdHtml(jsonLd)} />
  )}
  <header class="mb-10">
    <slot />
  </header>
  <PostStream
    posts={posts}
    visibleTags={visibleTags}
    showStrand
    germanSlugs={germanSlugs}
  />
  <p class="mt-12 text-center font-ui font-semibold text-brand-muted">
    {`${closing} `}
    <a
      href="/archive"
      class="text-brand-crimson underline decoration-2 underline-offset-[3px] hover:decoration-4"
    >
      The archive
    </a>{" "}
    has everything else.
  </p>
</div>
