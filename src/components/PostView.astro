---
import AuthorBios from "./AuthorBios.astro";
import Avatar from "./Avatar.astro";
import ContentfulImage from "./ContentfulImage.astro";
import Label from "./Label.astro";
import LanguageLink from "./LanguageLink.astro";
import Lightbox from "./Lightbox.astro";
import PostCard from "./PostCard.astro";
import TableOfContents from "./TableOfContents.astro";
import TagPill from "./TagPill.astro";
import UpdatedStamp from "./UpdatedStamp.astro";
import { postAuthors } from "../lib/authors";
import { GERMAN_LOCALE, SITE_AUTHOR, SITE_URL } from "../lib/constants";
import { coverAltText } from "../lib/cover-image";
import { coverPromptId } from "../lib/cover-prompt";
import { formatLongDate } from "../lib/date";
import { extractHeadings, hasTableOfContents } from "../lib/headings";
import { highlightCodeBlocks } from "../lib/highlight";
import { jsonLdHtml, postAuthorsNode } from "../lib/json-ld";
import { readingTimeMinutes } from "../lib/reading-time";
import { renderRichText } from "../lib/rich-text";
import { strandFor } from "../lib/strands";
import { postTags, visibleTagSlugs } from "../lib/tags";
import type { ListPost, Post } from "../lib/types";
import { widont } from "../lib/typography";

// The post body for both languages. German posts are kept out of the search
// index. Only the German parts carry de-DE; bio, tags and related posts stay
// in DEFAULT_LOCALE.
interface Props {
  post: Post;
  morePosts: ListPost[];
  allPosts: ListPost[];
  slug: string;
  german: boolean;
  /** The other language version, when there is one. */
  languageLink?: { href: string; lang: string; label: string };
}

const { post, morePosts, allPosts, slug, german, languageLink } = Astro.props;

const path = german ? `/de/posts/${slug}` : `/posts/${slug}`;
const lang = german ? GERMAN_LOCALE : undefined;
const visible = visibleTagSlugs(allPosts);
const tags = postTags(post).filter((t) => visible.has(t.slug));
const authors = postAuthors(post);
const strand = strandFor(post.category);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.excerpt,
  image: post.coverImage
    ? `${post.coverImage.url}?w=1200&h=630&fit=fill&fm=jpg&q=80`
    : `${SITE_URL}/be_useful.jpg`,
  datePublished: post.date,
  dateModified: post.updatedDate ?? post.date,
  author: postAuthorsNode(authors),
  publisher: { "@type": "Person", name: SITE_AUTHOR, url: SITE_URL },
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE_URL}${path}` },
  ...(german && { inLanguage: GERMAN_LOCALE }),
};

const showUpdated = post.updatedDate && post.updatedDate !== post.date;
const minutes = readingTimeMinutes(post.content.json);
// In German with the post. Reading time never breaks.
const readingTime = german ? `${minutes} Min. Lesezeit` : `${minutes} min read`;

const promptId = coverPromptId(post);
const headings = extractHeadings(post.content.json);
const hasToc = hasTableOfContents(headings);
// The owner's call per post, not automatic.
const numbered = post.numberedSections === true;

const body = renderRichText({
  content: post.content,
  headings,
  highlighted: await highlightCodeBlocks(post.content),
  coverPromptId: promptId,
  numbered,
});

// The indexed region. `url` gives search results the extensionless route; the
// strand feeds the result's pill and the date.
const indexed = german
  ? {}
  : {
      "data-pagefind-body": true,
      "data-pagefind-meta": strand
        ? "url[data-url], date[data-date], strand[data-strand], strandfill[data-strand-fill]"
        : "url[data-url], date[data-date]",
      "data-url": path,
      "data-date": formatLongDate(post.date),
      ...(strand && {
        "data-strand": strand.label,
        "data-strand-fill": strand.fill,
      }),
    };
---

<!-- No trail: the header presses the post's strand. A short header group, the
     cover, then the sidebar beside a quiet reading panel. -->
<div class="max-w-frame mx-auto px-4 md:px-10 pt-8 pb-12">
  <header>
    <!-- Its own indexed region: the h1 sits outside the article. German
         compounds outrun a phone line, so they hyphenate below md only. The
         title is never passed through widont(): the glued last two words can
         outgrow the column, so text-balance covers the widow instead. -->
    <h1
      data-pagefind-body={german ? undefined : true}
      lang={lang}
      class:list={[
        "max-w-[62.5rem] text-4xl leading-[0.98] font-[800] tracking-[-0.03em] text-balance wrap-break-word md:text-6xl",
        german && "hyphens-auto md:hyphens-manual",
      ]}
    >
      {post.title}
    </h1>
    <p
      lang={lang}
      class="mt-5 max-w-[51.25rem] text-xl leading-[1.45] text-pretty md:text-2xl"
    >
      {widont(post.excerpt)}
    </p>
    <div class="mt-7">
      <Avatar authors={authors}>
        <span class="tabular-nums text-brand-muted" lang={lang}>
          <time datetime={post.date}>{formatLongDate(post.date, german)}</time>
          {` · ${readingTime}`}
        </span>
        {showUpdated && (
          <UpdatedStamp date={post.updatedDate!} german={german} />
        )}
        {languageLink && <LanguageLink {...languageLink} />}
      </Avatar>
    </div>
  </header>
  <script type="application/ld+json" set:html={jsonLdHtml(jsonLd)} />
  <article {...indexed} class="mt-8 md:mt-11">
    {post.coverImage && (
      // A picture frame on the page: ink, never a shadow. 3:2 on phones,
      // 16:9 from md.
      <div class="relative overflow-hidden rounded-container border-[3px] border-outline">
        <div class="relative overflow-hidden bg-brand-dark/5 aspect-3/2 md:aspect-video">
          <ContentfulImage
            src={post.coverImage.url}
            alt={coverAltText(post.coverImage)}
            fill
            priority
            sizes="(width < 48rem) calc(100vw - 2rem - 6px), (width < 75rem) calc(100vw - 5rem - 6px), calc(70rem - 6px)"
            class="object-cover"
          />
        </div>
        {promptId && (
          // Over the image so the page keeps its position. A brush in the
          // header's button style, so it covers little of any cover.
          <a
            href="#cover-prompt"
            aria-label="Prompt for this cover image"
            data-pagefind-ignore
            class="absolute top-3 right-3 flex size-11 items-center justify-center rounded-xl border-[3px] border-outline bg-card text-brand-dark shadow-[3px_3px_0_var(--color-brand-crimson)] transition-[translate,box-shadow] duration-150 hover:translate-[3px] hover:shadow-none motion-reduce:transition-none md:top-4 md:right-4 md:shadow-[4px_4px_0_var(--color-brand-crimson)] md:hover:translate-[4px]"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9.06 11.9 8.07-8.06a2.85 2.85 0 1 1 4.03 4.03l-8.06 8.08" />
              <path d="M7.07 14.94c-1.66 0-3 1.35-3 3.02 0 1.33-2.5 1.52-2 2.02 1.08 1.1 2.49 2.02 4 2.02 2.2 0 4-1.8 4-4.04a3.01 3.01 0 0 0-3-3.02z" />
            </svg>
          </a>
        )}
      </div>
    )}
    <div class="mt-8 flex flex-col gap-6 md:mt-16 md:gap-10 xl:grid xl:grid-cols-[minmax(15rem,1fr)_minmax(0,49.25rem)] xl:gap-12">
      <!-- Stretches the row so the sticky wrapper has room, and keeps the
           column on xl when there is no contents list. -->
      <aside
        data-pagefind-ignore
        class:list={[
          "mx-auto w-full max-w-[49.25rem] xl:mx-0 xl:max-w-none",
          !hasToc && "hidden xl:block",
        ]}
      >
        <div class="xl:sticky xl:top-20">
          <TableOfContents
            headings={headings}
            lang={lang}
            numbered={numbered}
          />
        </div>
      </aside>

      <div class="mx-auto w-full max-w-[49.25rem] xl:mx-0">
        <!-- 49.25rem is the 42rem measure plus this padding and edge: the
             measure lives here, in rem, never on the prose in ch. Phones get
             no panel. -->
        <div class="pt-2 md:rounded-container md:border-2 md:border-edge-quiet md:bg-card md:px-14 md:py-12">
          <!-- Heading sizes are em, tracking the prose base. -->
          <div
            lang={lang}
            class="prose text-pretty prose-h2:text-[1.6em] prose-h3:text-[1.375em] prose-h3:font-[600] prose-h4:text-[1.15em]"
            set:html={body}
          />
        </div>
        {tags.length > 0 && (
          <nav
            aria-label="Tags"
            class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-2"
          >
            <span class="font-mono text-sm font-medium text-brand-muted">
              <span aria-hidden="true">// </span>tags
            </span>
            <ul class="flex flex-wrap items-center gap-2">
              {tags.map((tag) => (
                <li>
                  <TagPill tag={tag} />
                </li>
              ))}
            </ul>
          </nav>
        )}
        <div class="mt-10">
          <AuthorBios authors={authors} />
        </div>
      </div>
    </div>
  </article>
  {morePosts.length > 0 && (
    <section class="mt-20">
      <Label>more like this</Label>
      <ul class="grid gap-8 md:grid-cols-2 md:gap-9">
        {morePosts.map((card) => (
          <li class="flex">
            <PostCard post={card} showStrand across={2} />
          </li>
        ))}
      </ul>
    </section>
  )}
</div>
<Lightbox />

<script>
  // Copy buttons are revealed here, so with scripts off none is offered.
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "button[data-copy]",
  )) {
    const label = button.dataset.copy!;
    const noun = label.charAt(0).toUpperCase() + label.slice(1);
    const status = button.nextElementSibling!;
    let timer: number | undefined;
    button.classList.remove("invisible");

    button.addEventListener("click", async () => {
      const source = button
        .closest("[data-copy-root]")
        ?.querySelector("[data-copy-source]");
      try {
        await navigator.clipboard.writeText(source?.textContent ?? "");
      } catch {
        // Clipboard unavailable; fail quietly.
        return;
      }
      // The name tracks the visible text, so a speech user can say "click
      // Copied".
      button.textContent = "Copied";
      button.setAttribute("aria-label", `Copied ${label}`);
      status.textContent = `${noun} copied to clipboard`;
      // One timer at a time, so a second click gets its full two seconds.
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.textContent = "Copy";
        button.setAttribute("aria-label", `Copy ${label}`);
        status.textContent = "";
      }, 2000);
    });
  }
</script>
