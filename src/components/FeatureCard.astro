---
import CardCover from "./CardCover.astro";
import CardMeta from "./CardMeta.astro";
import TagPill from "./TagPill.astro";
import { STRANDS, strandFor } from "../lib/strands";
import type { ListPost, Tag } from "../lib/types";
import { widont } from "../lib/typography";

// The latest post, wide. Its cover is the page's largest image. From xl the
// text sits beside the cover and is clamped to fit, so the card is one height
// on every page.
interface Props {
  post: ListPost;
  /** Already filtered to tags with a live page. */
  tags: Tag[];
  showStrand: boolean;
}
const { post, tags, showStrand } = Astro.props;
const strand = strandFor(post.category) ?? STRANDS[0];
---

<!-- The whole card presses, but the title is its only link: the link's ::after
     covers the card, so a reader tabs to and hears one link per post. Anything
     else clickable sits above it with `relative z-10`. -->
<article
  class:list={[
    "relative border-[3px] border-outline bg-card transition-[translate,box-shadow] duration-150 hover:shadow-none motion-reduce:transition-none grid gap-6 overflow-hidden rounded-container hover:translate-[3px] md:gap-8 xl:grid-cols-12 xl:gap-0 md:hover:translate-[6px]",
    strand.featureShadow,
  ]}
>
  <!-- Stacked, then the frame less its edge until it stops growing, then
       beside the text from xl. -->
  <CardCover
    post={post}
    priority
    sizes="(width < 48rem) calc(100vw - 2.375rem), (width < 75rem) calc(100vw - 5.375rem), (width < 80rem) 1114px, 557px"
    class="aspect-3/2 xl:col-span-6"
  />
  <div
    class="flex flex-col gap-4 px-4 pb-5 md:px-6 md:pb-7 xl:col-span-6 xl:self-center xl:px-8 xl:py-4"
  >
    <CardMeta
      post={post}
      class="text-base xl:flex-nowrap"
      showStrand={showStrand}
      bylineClass="xl:min-w-0 xl:truncate"
    />
    <h3
      class="text-3xl xl:line-clamp-3 font-[800] leading-none tracking-[-0.02em] text-pretty md:text-4xl lg:text-[2.875rem]"
    >
      <a
        href={`/posts/${post.slug}`}
        class="after:absolute after:inset-0 after:content-[''] hover:text-brand-crimson transition-colors duration-200"
        >{widont(post.title)}</a
      >
    </h3>
    <p class="text-lg leading-relaxed text-pretty xl:line-clamp-2">
      {widont(post.excerpt)}
    </p>
    <!-- Phones drop the pills: two wrapped lines, and the post carries them. -->
    {
      tags.length > 0 && (
        <ul
          aria-label="Tags"
          class="flex flex-wrap gap-2 pointer-coarse:gap-y-3 relative z-10 max-md:hidden"
        >
          {tags.map((tag) => (
            <li>
              <TagPill tag={tag} size="compact" />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
