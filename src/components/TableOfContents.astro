---
import Tape from "./Tape.astro";
import TocNav from "./TocNav.astro";
import { hasTableOfContents, type Heading } from "../lib/headings";

// The nav is rendered twice, behind the phone disclosure and bare from xl.
// Only one is displayed at any width, so there is never a duplicate landmark.
// Do not collapse it to one <details> forced open by CSS: without [open] it
// reports a collapsed widget even while visible.
interface Props {
  headings: Heading[];
  lang?: string;
  numbered?: boolean;
}
const { headings, lang, numbered = false } = Astro.props;
---

{
  hasTableOfContents(headings) && (
    <>
      <details class="group overflow-hidden rounded-container border-[3px] border-outline bg-card xl:hidden">
        <summary class="list-none flex min-h-12 items-center justify-between gap-3 cursor-pointer select-none px-5 py-3 font-mono text-sm font-medium text-brand-muted">
          <span>
            <span aria-hidden="true">// </span>on this page
          </span>
          <svg
            class="h-4 w-4 text-brand-muted motion-safe:transition-transform motion-safe:duration-200 group-open:rotate-180"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
              clip-rule="evenodd"
            />
          </svg>
        </summary>
        <div class="px-5 pb-2">
          <TocNav headings={headings} lang={lang} numbered={numbered} />
        </div>
      </details>
      {/* The page's one strip of tape. Read, not pressed, so the quiet edge;
          the phone disclosure keeps ink. */}
      <div class="relative hidden rounded-container border-2 border-edge-quiet bg-card px-5.5 pt-5 pb-6 xl:block">
        <Tape />
        <TocNav headings={headings} lang={lang} numbered={numbered} />
      </div>
    </>
  )
}

<script>
  import { activationBandTop, pickActiveHeading } from "../lib/toc-active";

  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>("[data-toc] a"),
  ];
  const slugOf = (link: HTMLAnchorElement) =>
    link.getAttribute("href")!.slice(1);
  const headings = [...new Set(links.map(slugOf))]
    .map((slug) => document.getElementById(slug))
    .filter((el): el is HTMLElement => el !== null);

  if (headings.length > 0) {
    const mark = (slug: string) => {
      for (const link of links) {
        if (slugOf(link) === slug) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      }
    };

    // A targeted heading (a click here, or a deep link at load) holds the
    // highlight until the reader next wheels, taps or presses a key. Geometry
    // alone would hand it to the section above whenever the target cannot
    // reach the line, which is every short section at the foot of a post.
    let pinned = false;
    let release: AbortController | undefined;
    const pin = (slug: string) => {
      release?.abort();
      release = new AbortController();
      pinned = true;
      mark(slug);
      const unpin = () => {
        pinned = false;
        release?.abort();
      };
      const options = { once: true, passive: true, signal: release.signal };
      window.addEventListener("wheel", unpin, options);
      window.addEventListener("pointerdown", unpin, options);
      window.addEventListener("keydown", unpin, options);
    };

    // The line a heading must cross to become active: html's
    // scroll-padding-top, the one scroll offset.
    const bandTop = activationBandTop(
      getComputedStyle(document.documentElement).scrollPaddingTop,
    );
    const recompute = () => {
      if (pinned) return;
      mark(
        pickActiveHeading(
          headings.map((el) => ({
            id: el.id,
            top: el.getBoundingClientRect().top,
          })),
          bandTop,
        ),
      );
    };

    let frame = 0;
    const schedule = () => {
      frame ||= requestAnimationFrame(() => {
        frame = 0;
        recompute();
      });
    };
    // Scroll is the common case. The observer catches what moves a heading
    // with no scroll: the web-font swap, and a change of window width.
    window.addEventListener("scroll", schedule, { passive: true });
    new ResizeObserver(schedule).observe(document.body);

    for (const link of links) {
      link.addEventListener("click", () => pin(slugOf(link)));
    }

    // A hand-typed "#%" makes decodeURIComponent throw. It matches no heading
    // either way.
    let hash = "";
    try {
      hash = decodeURIComponent(location.hash.slice(1));
    } catch {}
    if (headings.some((el) => el.id === hash)) pin(hash);
    else recompute();
  }
</script>
