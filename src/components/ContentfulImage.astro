---
import {
  avifSrcset,
  fixedSource,
  loadingAttributes,
  responsiveSource,
} from "../lib/image";

interface Props {
  src: string;
  alt: string;
  /** With `sizes` the browser picks a width; without, `width` is the size. */
  sizes?: string;
  width?: number;
  height?: number;
  /** Fills its positioned parent, which sets the shape. */
  fill?: boolean;
  /** The page's largest image only. */
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  sizes,
  width,
  height,
  fill = false,
  priority = false,
  class: className,
} = Astro.props;

const source = sizes ? responsiveSource(src, sizes) : fixedSource(src, width!);
// Covers and cards only: a portrait is flat art, which AVIF can make larger.
const avif = sizes ? avifSrcset(src) : undefined;
const Wrapper = avif ? "picture" : Fragment;
---

<Wrapper>
  {avif && <source type="image/avif" srcset={avif} sizes={sizes} />}

  <img
    {...source}
    alt={alt}
    width={fill ? undefined : width}
    height={fill ? undefined : height}
    {...loadingAttributes(priority)}
    class:list={[fill && "absolute inset-0 size-full", className]}
  />
</Wrapper>
