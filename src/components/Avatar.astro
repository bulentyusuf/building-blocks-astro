---
import ContentfulImage from "./ContentfulImage.astro";
import type { Author } from "../lib/types";

// The byline row: the authors' ringed portraits stacked, their names as one
// line ("A, B & C"), then the slotted meta. No authors still renders the meta,
// so the date is never lost: callers must not guard on the list's length.
interface Props {
  authors: Pick<Author, "name" | "slug" | "picture">[];
}
const { authors } = Astro.props;
const last = authors.length - 1;

function initials(name: string): string {
  return name
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part.charAt(0).toUpperCase())
    .join("");
}
---

<div class="flex flex-wrap items-center gap-x-4 gap-y-3 font-ui text-base">
  {authors.length > 0 && (
    <div class="flex items-center gap-2.5">
      {/* Portraits overlap as one group, decoration beside the names. */}
      <span aria-hidden="true" class="flex shrink-0 -space-x-3">
        {authors.map((author) => (
          <span class="h-10 w-10 rounded-full border-[3px] border-outline bg-brand-bg">
            {author.picture?.url ? (
              <ContentfulImage
                src={author.picture.url}
                alt=""
                width={40}
                height={40}
                class="h-full w-full rounded-full object-cover"
              />
            ) : (
              <span class="flex h-full w-full items-center justify-center rounded-full bg-brand-dark/10 text-xs font-bold text-brand-muted">
                {initials(author.name)}
              </span>
            )}
          </span>
        ))}
      </span>
      {/* Names may wrap; clipping would be worse. */}
      <p class="font-[800]">
        {authors.map((author, i) => (
          <Fragment>
            {i > 0 && (i === last ? " & " : ", ")}
            {author.slug ? (
              <a
                href={`/authors/${author.slug}`}
                class="transition-colors duration-200 pointer-coarse:relative pointer-coarse:py-3.5 hover:text-brand-crimson"
              >
                {author.name}
              </a>
            ) : (
              author.name
            )}
          </Fragment>
        ))}
      </p>
    </div>
  )}
  <slot />
</div>
