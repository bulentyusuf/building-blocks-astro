---
import StrandPill from "./StrandPill.astro";
import { GERMAN_LOCALE } from "../lib/constants";
import { formatDayMonth, formatLongDate } from "../lib/date";
import { strandFor } from "../lib/strands";
import type { ListPost } from "../lib/types";
import { widont } from "../lib/typography";

// One compact row: date, title, strand. The archive shows day and month under
// its year heading; elsewhere there is no year heading, so the full date.
// Three fixed lanes from sm. Below it the title comes first, then the strand
// as a coloured dot before the date on one line.
interface Props {
  post: ListPost;
  german: boolean;
  date: "dayMonth" | "long";
  /** Off on a strand page, where every row would repeat the page's strand. */
  showStrand: boolean;
}
const { post, german, date, showStrand } = Astro.props;
const strand = showStrand ? strandFor(post.category) : undefined;
---

<li
  class:list={[
    "grid grid-cols-[auto_1fr] items-baseline gap-x-2 gap-y-1.5 px-5 py-3.5 even:bg-brand-bg sm:gap-x-6 sm:px-7",
    date === "dayMonth"
      ? "sm:grid-cols-[4.75rem_1fr_auto]"
      : "sm:grid-cols-[9.5rem_1fr_auto]",
  ]}
>
  <span
    class="order-3 font-ui text-[0.9375rem] font-semibold tabular-nums text-brand-muted sm:order-1"
    ><time datetime={post.date}
      >{
        date === "dayMonth"
          ? formatDayMonth(post.date)
          : formatLongDate(post.date)
      }</time
    >{
      // The heading carries the year; restore it for link navigation.
      date === "dayMonth" && (
        <span class="sr-only"> {new Date(post.date).getUTCFullYear()}</span>
      )
    }</span
  >
  <span class="order-1 col-span-full sm:order-2 sm:col-span-1">
    <a
      href={`/posts/${post.slug}`}
      class="font-ui text-xl leading-snug font-bold pointer-coarse:relative pointer-coarse:py-3 transition-colors duration-200 hover:text-brand-crimson"
      >{widont(post.title)}</a
    >{
      // Where a browsing reader learns a German version exists. The visible
      // "DE" stays in the link's name.
      german && (
        <a
          href={`/de/posts/${post.slug}`}
          hreflang={GERMAN_LOCALE}
          lang={GERMAN_LOCALE}
          class="tap-area -my-1 ml-1 inline-block px-1.5 py-1 whitespace-nowrap pointer-coarse:ml-2.5 font-ui text-xs font-bold tracking-[0.06em] text-brand-muted transition-colors duration-200 hover:text-brand-crimson"
        >
          <span class="sr-only">Auf Deutsch lesen, </span>DE
        </a>
      )
    }
  </span>
  {
    strand && (
      // Phones: a dot, not a link, so no undersized tap target. After the
      // title in the source, so a screen reader hears it there.
      <span
        class:list={[
          "order-2 size-3 self-center rounded-full border-2 border-brand-dark sm:hidden",
          strand.fill,
        ]}
      >
        <span class="sr-only">in {strand.label}</span>
      </span>
    )
  }
  {
    strand && (
      <a
        href={`/categories/${strand.slug}`}
        class="tap-area order-3 hidden justify-self-end sm:block"
      >
        {/* Keeps the title from running into the strand. */}
        <span class="sr-only">in </span>
        <StrandPill strand={strand} />
      </a>
    )
  }
</li>
