---
import "../styles/global.css";
import { Font } from "astro:assets";
import BackToTop from "../components/BackToTop.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { getAllAuthors, getAllPosts } from "../lib/api";
import {
  DEFAULT_LOCALE,
  DEFAULT_OG_LOCALE,
  SITE_DESCRIPTION,
  SITE_TITLE,
  SITE_URL,
  THEME_COLOR,
  THEME_COLOR_DARK,
} from "../lib/constants";
import { PREVIEW_PATH } from "../lib/preview-session";
import { currentStrand } from "../lib/strands";

interface Props {
  /** The whole document title. */
  title: string;
  description: string;
  canonical: string;
  /** A draft page: drafts feed the chrome too, and the exit button shows. */
  preview?: boolean;
}

const { title, description, canonical, preview = false } = Astro.props;

const [posts, authors] = await Promise.all([
  getAllPosts(preview),
  getAllAuthors(preview),
]);
const postStrands = Object.fromEntries(
  posts.flatMap((p) => (p.category ? [[p.slug, p.category.slug]] : [])),
);
// The route, without the file name a build gives it. A draft presses the chip
// its published page would.
const path =
  Astro.url.pathname.replace(/(\/index)?\.html$/, "").replace(/\/$/, "") || "/";
const strand = currentStrand(
  preview ? path.slice(PREVIEW_PATH.length) : path,
  postStrands,
);
---

<!doctype html>
<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Latin only. The italic loads on demand: nothing above the fold is set
         in it. -->
    <Font cssVariable="--font-bricolage" preload />
    <Font cssVariable="--font-literata" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-plex-mono" preload />
    <!-- Literal colours: a meta tag cannot read a custom property. -->
    <meta
      name="theme-color"
      content={THEME_COLOR}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={THEME_COLOR_DARK}
      media="(prefers-color-scheme: dark)"
    />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonical} />
    <slot name="social">
      <meta property="og:title" content={SITE_TITLE} />
      <meta property="og:description" content={SITE_DESCRIPTION} />
      <meta property="og:url" content={canonical} />
      <meta property="og:site_name" content={SITE_TITLE} />
      <meta property="og:locale" content={DEFAULT_OG_LOCALE} />
      <meta property="og:image" content={`${SITE_URL}/be_useful.jpg`} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={SITE_TITLE} />
      <meta property="og:type" content="website" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={SITE_TITLE} />
      <meta name="twitter:description" content={SITE_DESCRIPTION} />
      <meta name="twitter:image" content={`${SITE_URL}/be_useful.jpg`} />
    </slot>
    <link rel="icon" href="/favicon.ico" sizes="48x48" type="image/x-icon" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <link rel="preconnect" href="https://images.ctfassets.net" />
  </head>
  <body class="min-h-screen flex flex-col bg-brand-bg text-brand-dark">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-2 focus:z-[100] focus:rounded-md focus:bg-brand-dark focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-brand-bg"
      >Skip to content</a
    >
    <Header strand={strand} />
    <!-- Focusable, for browsers that do not move focus on a fragment jump. -->
    <main id="main" tabindex="-1" class="grow">
      <slot />
    </main>
    <Footer authors={authors} />
    {
      preview && (
        // A two-tone ring: crimson would vanish on the button's own fill.
        <form
          method="post"
          action="/api/exit-preview"
          class="fixed top-20 right-5 z-40"
        >
          <button
            type="submit"
            class="bg-brand-crimson text-white px-3 py-1.5 rounded-md text-sm font-bold shadow-md hover:opacity-90 transition-opacity duration-200 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-surface-dark"
          >
            Exit preview
          </button>
        </form>
      )
    }
    <BackToTop />
  </body>
</html>
