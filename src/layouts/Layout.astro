---
import "../styles/global.css";
import { Font } from "astro:assets";
import BackToTop from "../components/BackToTop.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { getAllAuthors } from "../lib/api";
import {
  DEFAULT_LOCALE,
  DEFAULT_OG_LOCALE,
  SITE_DESCRIPTION,
  SITE_TITLE,
  SITE_URL,
  THEME_COLOR,
  THEME_COLOR_DARK,
} from "../lib/constants";
import { PREVIEW_PATH } from "../lib/preview-session";
import { currentStrand } from "../lib/strands";

interface Props {
  /** The whole document title. */
  title: string;
  description: string;
  /** Absent on pages search engines are kept away from. */
  canonical?: string;
  /** Keeps the page out of search engines whatever the build allows. */
  noindex?: boolean;
  /** The page's own social card text. Absent means the site's. */
  social?: {
    title: string;
    /** The short form some cards show beside the site name. */
    shortTitle?: string;
    /** Its own picture. A square one gets the small card, not the wide one. */
    image?: { url: string; alt: string; width: number; height: number };
  };
  /** A draft page: drafts feed the chrome too, and the exit button shows. */
  preview?: boolean;
  /** A post page's strand, so the header presses its chip. */
  postStrand?: string;
}

const {
  title,
  description,
  canonical,
  noindex = false,
  social,
  preview = false,
  postStrand,
} = Astro.props;

const cardImage = social?.image ?? {
  url: `${SITE_URL}/be_useful.jpg`,
  alt: SITE_TITLE,
  width: 1200,
  height: 630,
};
const square = cardImage.width === cardImage.height;

const authors = await getAllAuthors(preview);
// The route, without the file name a build gives it. A draft presses the chip
// its published page would.
const path =
  Astro.url.pathname.replace(/(\/index)?\.html$/, "").replace(/\/$/, "") || "/";
const strand = currentStrand(
  preview ? path.slice(PREVIEW_PATH.length) : path,
  postStrand,
);
---

<!doctype html>
<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Latin only. The italic loads on demand: nothing above the fold is set
         in it. -->
    <Font cssVariable="--font-bricolage" preload />
    <Font cssVariable="--font-literata" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-plex-mono" preload />
    <!-- Literal colours: a meta tag cannot read a custom property. -->
    <meta
      name="theme-color"
      content={THEME_COLOR}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={THEME_COLOR_DARK}
      media="(prefers-color-scheme: dark)"
    />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="manifest" href="/manifest.webmanifest" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      href={`${SITE_URL}/feed.xml`}
    />
    <slot name="social">
      <meta property="og:title" content={social?.title ?? SITE_TITLE} />
      <meta
        property="og:description"
        content={social ? description : SITE_DESCRIPTION}
      />
      <meta property="og:url" content={(social && canonical) || SITE_URL} />
      <meta property="og:site_name" content={SITE_TITLE} />
      <meta property="og:locale" content={DEFAULT_OG_LOCALE} />
      <meta property="og:image" content={cardImage.url} />
      <meta property="og:image:width" content={String(cardImage.width)} />
      <meta property="og:image:height" content={String(cardImage.height)} />
      <meta property="og:image:alt" content={cardImage.alt} />
      <meta property="og:type" content="website" />
      <meta
        name="twitter:card"
        content={square ? "summary" : "summary_large_image"}
      />
      <meta
        name="twitter:title"
        content={social?.shortTitle ?? social?.title ?? SITE_TITLE}
      />
      <meta
        name="twitter:description"
        content={social ? description : SITE_DESCRIPTION}
      />
      <meta name="twitter:image" content={cardImage.url} />
    </slot>
    <link rel="icon" href="/favicon.ico" sizes="48x48" type="image/x-icon" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <link rel="preconnect" href="https://images.ctfassets.net" />
  </head>
  <body class="min-h-screen flex flex-col bg-brand-bg text-brand-dark">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-2 focus:z-[100] focus:rounded-md focus:bg-brand-dark focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-brand-bg"
    >
      Skip to content
    </a>
    <Header strand={strand} />
    <!-- Focusable, for browsers that do not move focus on a fragment jump. -->
    <main id="main" tabindex="-1" class="grow">
      <slot />
    </main>
    <Footer authors={authors} />
    {preview && (
      // A two-tone ring: crimson would vanish on the button's own fill. The
      // label is the page ground, which flips with the crimson.
      <form
        method="post"
        action="/api/exit-preview"
        class="fixed bottom-6 left-5 z-40"
      >
        <button
          type="submit"
          class="bg-brand-crimson text-brand-bg min-h-11 px-3 inline-flex items-center rounded-md text-sm font-bold shadow-md hover:opacity-90 transition-opacity duration-200 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-surface-dark"
        >
          Exit preview
        </button>
      </form>
    )}
    <BackToTop />
    {__ANALYTICS_TOKEN__ && !preview && (
      <script
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({
          token: __ANALYTICS_TOKEN__,
        })}
      />
    )}
  </body>
</html>
